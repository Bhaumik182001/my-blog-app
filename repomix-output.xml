                                {rank <= 3 ? `🏆 ${rank}` : rank}
                              </span>
                              <span className={`text-[9px] font-bold ${deltaColor}`}>{delta}</span>
                            </div>
                          </td>
                          <td className="p-4 font-bold text-slate-200">
                            <Link to={`/blog/${post.slug}`} className="hover:text-cyan-400 transition-colors">
                              {post.title}
