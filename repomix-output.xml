<file path="src/components/FocusTimer.jsx">
import React, { useState, useEffect, useRef } from "react";
import { useApp } from "../context/AppContext";
import { Play, Pause, RotateCcw, Flame, CheckCircle } from "lucide-react";

export default function FocusTimer() {
  const { state, dispatch, showToast } = useApp();
  const [mode, setMode] = useState("focus"); // "focus" or "break"
  const [timeLeft, setTimeLeft] = useState(25 * 60); // 25 minutes
  const [isRunning, setIsRunning] = useState(false);
  const timerRef = useRef(null);

  const durationMap = {
    focus: 25 * 60,
    break: 5 * 60
  };

  useEffect(() => {
    setTimeLeft(durationMap[mode]);
    setIsRunning(false);
    if (timerRef.current) clearInterval(timerRef.current);
  }, [mode]);

  useEffect(() => {
    if (isRunning) {
      timerRef.current = setInterval(() => {
        setTimeLeft((prev) => {
          if (prev <= 1) {
            clearInterval(timerRef.current);
            setIsRunning(false);
            
            if (mode === "focus") {
              dispatch({ type: "INCREMENT_FOCUS_SESSION" });
              showToast("Focus session completed! Take a break.", "success");
              setMode("break");
            } else {
              showToast("Break finished! Time to focus.", "info");
              setMode("focus");
            }
            return 0;
          }
          return prev - 1;
        });
      }, 1000);
    } else {
      if (timerRef.current) clearInterval(timerRef.current);
    }

    return () => {
      if (timerRef.current) clearInterval(timerRef.current);
    };
  }, [isRunning, mode]);

  const handleReset = () => {
    setIsRunning(false);
    setTimeLeft(durationMap[mode]);
  };

  const formatTime = (secs) => {
    const mins = Math.floor(secs / 60);
    const s = secs % 60;
    return `${mins.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}`;
  };

  const percent = ((durationMap[mode] - timeLeft) / durationMap[mode]) * 100;

  return (
    <div className="bg-slate-900/35 border border-slate-800/70 rounded-2xl p-5 backdrop-blur-md shadow-xl shadow-cyan-950/10 space-y-4">
      {/* Title */}
      <div className="flex items-center justify-between border-b border-slate-800/60 pb-3">
        <div className="flex items-center space-x-2">
          <Flame className="text-cyan-400" size={18} />
          <h4 className="text-sm font-bold text-slate-200 uppercase tracking-wider">Pomodoro Focus Timer</h4>
        </div>
        <div className="flex items-center space-x-1 bg-slate-950/40 border border-slate-800/40 rounded-full px-2.5 py-0.5 text-[10px] font-bold text-cyan-400">
          <span>Streak: {state.focusSessions || 0} cycles</span>
        </div>
      </div>

      {/* Mode selectors */}
      <div className="flex bg-slate-950/40 border border-slate-800/50 rounded-lg p-0.5">
        <button
          onClick={() => setMode("focus")}
          className={`flex-1 text-center py-1.5 rounded-md text-xs font-bold transition-all ${
            mode === "focus" 
              ? "bg-gradient-to-r from-cyan-500/10 to-blue-500/10 border border-cyan-500/25 text-cyan-400" 
              : "text-slate-500 hover:text-slate-300"
          }`}
        >
          Focus (25m)
        </button>
        <button
          onClick={() => setMode("break")}
          className={`flex-1 text-center py-1.5 rounded-md text-xs font-bold transition-all ${
            mode === "break" 
              ? "bg-gradient-to-r from-cyan-500/10 to-blue-500/10 border border-cyan-500/25 text-cyan-400" 
              : "text-slate-500 hover:text-slate-300"
          }`}
        >
          Break (5m)
        </button>
      </div>

      {/* Visual countdown progress circle */}
      <div className="flex flex-col items-center justify-center py-4 relative">
        <div className="relative w-36 h-36 flex items-center justify-center">
          {/* SVG ring background */}
          <svg className="w-full h-full transform -rotate-90">
            <circle
              cx="72"
              cy="72"
              r="62"
              className="stroke-slate-800"
              strokeWidth="4"
              fill="transparent"
            />
            <circle
              cx="72"
              cy="72"
              r="62"
              className="stroke-cyan-500/70"
              strokeWidth="4"
              fill="transparent"
              strokeDasharray={2 * Math.PI * 62}
              strokeDashoffset={2 * Math.PI * 62 * (1 - percent / 100)}
              strokeLinecap="round"
            />
          </svg>
          
          {/* Center text */}
          <div className="absolute flex flex-col items-center justify-center text-center">
            <span className="text-3xl font-black font-mono tabular-nums text-slate-100 leading-none">
              {formatTime(timeLeft)}
            </span>
            <span className="text-[9px] uppercase tracking-widest text-slate-500 font-bold mt-1">
              {mode === "focus" ? "Studying" : "Resting"}
            </span>
          </div>
        </div>
      </div>

      {/* Buttons */}
      <div className="flex justify-center items-center space-x-3">
        <button
          onClick={handleReset}
          className="p-2 bg-slate-950/40 hover:bg-slate-900 border border-slate-800 rounded-xl text-slate-400 hover:text-slate-200 transition-colors"
          title="Reset Timer"
        >
          <RotateCcw size={16} />
        </button>
        <button
          onClick={() => setIsRunning(!isRunning)}
          className={`px-6 py-2.5 rounded-xl text-xs font-bold shadow-md transition-all active:scale-95 flex items-center space-x-2 ${
            isRunning 
              ? "bg-slate-900 border border-slate-800 text-slate-200 hover:bg-slate-800"
              : "bg-gradient-to-r from-cyan-500 to-blue-500 text-slate-950 hover:opacity-95 shadow-cyan-500/10"
          }`}
        >
          {isRunning ? (
            <>
              <Pause size={14} fill="currentColor" />
              <span>Pause</span>
            </>
          ) : (
            <>
              <Play size={14} fill="currentColor" />
              <span>Start</span>
            </>
          )}
        </button>
      </div>
    </div>
  );
}
</file>

<file path="src/components/GitHubTrending.jsx">
import React, { useState, useEffect } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { Star, GitFork, ExternalLink, RefreshCw, AlertCircle, Circle } from "lucide-react";

const TABS = [
  { label: "DevOps",        query: "topic:devops+topic:cicd" },
  { label: "Architecture",  query: "topic:microservices+topic:distributed-systems" },
  { label: "Frontend",      query: "topic:react+topic:typescript" },
];

const langColors = {
  TypeScript:  "#3178c6",
  JavaScript:  "#f1e05a",
  Go:          "#00ADD8",
  Python:      "#3572A5",
  Rust:        "#dea584",
  Java:        "#b07219",
  "C++":       "#f34b7d",
  Shell:       "#89e051",
  Dockerfile:  "#384d54",
  Kotlin:      "#A97BFF",
};

function SkeletonCard() {
  return (
    <div className="p-3 border border-slate-800/60 rounded-xl animate-pulse space-y-2">
      <div className="h-3 bg-slate-800 rounded w-3/4" />
      <div className="h-2.5 bg-slate-800/60 rounded w-full" />
      <div className="flex gap-3">
        <div className="h-2.5 bg-slate-800/60 rounded w-12" />
        <div className="h-2.5 bg-slate-800/60 rounded w-10" />
      </div>
    </div>
  );
}

function fmtNum(n) {
  if (n >= 1000) return (n / 1000).toFixed(1) + "k";
  return n;
}

export default function GitHubTrending() {
  const [activeTab, setActiveTab] = useState(0);
  const [repos, setRepos] = useState({});
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  const fetchRepos = async (tabIdx) => {
    const q = TABS[tabIdx].query;
    if (repos[tabIdx]) return; // cached
    setLoading(true);
    setError(null);
    try {
      const res = await fetch(
        `https://api.github.com/search/repositories?q=${q}&sort=stars&order=desc&per_page=4`,
        { headers: { Accept: "application/vnd.github+json" } }
      );
      if (!res.ok) throw new Error("GitHub API limit reached");
      const data = await res.json();
      setRepos(prev => ({ ...prev, [tabIdx]: data.items }));
    } catch (e) {
      setError(e.message || "Could not fetch repos.");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchRepos(activeTab);
  }, [activeTab]);

  const currentRepos = repos[activeTab] || [];

  return (
    <div className="bg-slate-900/40 border border-slate-800/80 rounded-2xl overflow-hidden">
      {/* Header */}
      <div className="flex items-center justify-between px-4 py-3 border-b border-slate-800/60">
        <div className="flex items-center space-x-2">
          <div className="w-5 h-5 bg-slate-200 rounded flex items-center justify-center">
            <span className="text-slate-950 font-black text-[10px]">GH</span>
          </div>
          <span className="text-sm font-bold text-slate-200">GitHub Trending</span>
        </div>
        <button
          onClick={() => {
            setRepos(prev => { const n = {...prev}; delete n[activeTab]; return n; });
            fetchRepos(activeTab);
          }}
          disabled={loading}
          className="text-slate-500 hover:text-cyan-400 transition-colors disabled:opacity-40"
          title="Refresh"
        >
          <RefreshCw size={13} className={loading ? "animate-spin" : ""} />
        </button>
      </div>

      {/* Tabs */}
      <div className="flex border-b border-slate-800/60 bg-slate-950/20">
        {TABS.map((t, i) => (
          <button
            key={i}
            onClick={() => setActiveTab(i)}
            className={`flex-1 px-2 py-2 text-[10px] font-bold uppercase tracking-wider transition-colors relative ${
              activeTab === i ? "text-cyan-400" : "text-slate-500 hover:text-slate-300"
            }`}
          >
            {t.label}
            {activeTab === i && (
              <motion.div
                layoutId="gh-tab"
                className="absolute bottom-0 left-0 right-0 h-0.5 bg-cyan-500"
              />
            )}
          </button>
        ))}
      </div>

      {/* Cards */}
      <div className="p-3 space-y-2.5">
        {loading && !currentRepos.length ? (
          Array.from({ length: 4 }).map((_, i) => <SkeletonCard key={i} />)
        ) : error ? (
          <div className="flex flex-col items-center justify-center py-6 text-center">
            <AlertCircle size={22} className="text-amber-400 mb-2" />
            <p className="text-xs text-slate-400">{error}</p>
            <p className="text-[10px] text-slate-600 mt-1">GitHub API: 60 req/hr unauthenticated</p>
          </div>
        ) : (
          <AnimatePresence mode="wait">
            <motion.div
              key={activeTab}
              initial={{ opacity: 0, y: 6 }}
              animate={{ opacity: 1, y: 0 }}
              exit={{ opacity: 0, y: -6 }}
              className="space-y-2.5"
            >
              {currentRepos.map((repo) => (
                <a
                  key={repo.id}
                  href={repo.html_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="block p-3 border border-slate-800/60 rounded-xl hover:border-cyan-500/20 hover:bg-slate-800/30 transition-all group"
                >
                  <div className="flex items-start justify-between gap-2">
                    <p className="text-xs font-bold text-slate-200 group-hover:text-cyan-400 transition-colors leading-snug line-clamp-1">
                      {repo.full_name}
                    </p>
                    <ExternalLink size={11} className="text-slate-600 group-hover:text-cyan-400 transition-colors shrink-0 mt-0.5" />
                  </div>
                  {repo.description && (
                    <p className="text-[11px] text-slate-500 mt-1 line-clamp-2 leading-relaxed">
                      {repo.description}
                    </p>
                  )}
                  <div className="flex items-center gap-3 mt-2 text-[10px] text-slate-600">
                    {repo.language && (
                      <span className="flex items-center gap-1">
                        <Circle
                          size={8}
                          style={{ color: langColors[repo.language] || "#8888aa" }}
                          className="fill-current"
                        />
                        {repo.language}
                      </span>
                    )}
                    <span className="flex items-center gap-1">
                      <Star size={9} className="text-amber-400" />
                      {fmtNum(repo.stargazers_count)}
                    </span>
                    <span className="flex items-center gap-1">
                      <GitFork size={9} />
                      {fmtNum(repo.forks_count)}
                    </span>
                  </div>
                </a>
              ))}
            </motion.div>
          </AnimatePresence>
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/components/HackerNewsFeed.jsx">
import React, { useState, useEffect } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { ExternalLink, TrendingUp, ThumbsUp, User, RefreshCw, AlertCircle } from "lucide-react";

const HN_BASE = "https://hacker-news.firebaseio.com/v0";
const STORY_COUNT = 6;

function SkeletonRow() {
  return (
    <div className="flex items-start gap-3 p-3 animate-pulse">
      <div className="w-8 h-8 bg-slate-800 rounded-lg shrink-0" />
      <div className="flex-grow space-y-1.5">
        <div className="h-3 bg-slate-800 rounded w-full" />
        <div className="h-3 bg-slate-800 rounded w-3/4" />
        <div className="h-2.5 bg-slate-800/60 rounded w-1/2" />
      </div>
    </div>
  );
}

export default function HackerNewsFeed() {
  const [stories, setStories] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [lastFetch, setLastFetch] = useState(null);

  const fetchStories = async () => {
    setLoading(true);
    setError(null);
    try {
      const idsRes = await fetch(`${HN_BASE}/topstories.json`);
      const ids = await idsRes.json();
      const top = ids.slice(0, STORY_COUNT);
      const fetched = await Promise.all(
        top.map(id => fetch(`${HN_BASE}/item/${id}.json`).then(r => r.json()))
      );
      setStories(fetched.filter(s => s && s.title));
      setLastFetch(new Date());
    } catch (e) {
      setError("Could not reach Hacker News. Check your connection.");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchStories();
    // Auto-refresh every 5 minutes
    const interval = setInterval(fetchStories, 5 * 60 * 1000);
    return () => clearInterval(interval);
  }, []);

  return (
    <div className="bg-slate-900/40 border border-slate-800/80 rounded-2xl overflow-hidden">
      {/* Header */}
      <div className="flex items-center justify-between px-4 py-3 border-b border-slate-800/60">
        <div className="flex items-center space-x-2">
          <div className="w-5 h-5 bg-orange-500 rounded flex items-center justify-center">
            <span className="text-white font-black text-[9px]">Y</span>
          </div>
          <span className="text-sm font-bold text-slate-200">Hacker News Live</span>
          <span className="px-1.5 py-0.5 bg-emerald-500/15 border border-emerald-500/25 text-emerald-400 text-[9px] font-bold uppercase rounded-full animate-pulse">
            Live
          </span>
        </div>
        <button
          onClick={fetchStories}
          disabled={loading}
          className="text-slate-500 hover:text-cyan-400 transition-colors disabled:opacity-40"
          title="Refresh"
        >
          <RefreshCw size={13} className={loading ? "animate-spin" : ""} />
        </button>
      </div>

      {/* Body */}
      <div className="divide-y divide-slate-800/40">
        {loading ? (
          Array.from({ length: STORY_COUNT }).map((_, i) => <SkeletonRow key={i} />)
        ) : error ? (
          <div className="flex flex-col items-center justify-center py-8 text-center px-4">
            <AlertCircle size={24} className="text-rose-400 mb-2" />
            <p className="text-xs text-slate-400">{error}</p>
            <button
              onClick={fetchStories}
              className="mt-3 text-xs text-cyan-400 font-semibold hover:underline"
            >
              Try again
            </button>
          </div>
        ) : (
          <AnimatePresence>
            {stories.map((story, i) => (
              <motion.a
                key={story.id}
                href={story.url || `https://news.ycombinator.com/item?id=${story.id}`}
                target="_blank"
                rel="noopener noreferrer"
                initial={{ opacity: 0, x: -8 }}
                animate={{ opacity: 1, x: 0 }}
                transition={{ delay: i * 0.05 }}
                className="flex items-start gap-3 p-3 hover:bg-slate-800/40 transition-colors group block"
              >
                {/* Rank badge */}
                <div className="w-7 h-7 bg-slate-800/80 rounded-lg flex items-center justify-center text-[10px] font-black text-slate-500 group-hover:text-orange-400 transition-colors shrink-0 mt-0.5">
                  {i + 1}
                </div>
                <div className="flex-grow min-w-0">
                  <p className="text-xs font-semibold text-slate-300 group-hover:text-slate-100 leading-snug line-clamp-2 transition-colors">
                    {story.title}
                  </p>
                  <div className="flex items-center gap-3 mt-1.5 text-[10px] text-slate-600">
                    <span className="flex items-center gap-1">
                      <ThumbsUp size={9} />
                      {story.score}
                    </span>
                    <span className="flex items-center gap-1">
                      <User size={9} />
                      {story.by}
                    </span>
                  </div>
                </div>
                <ExternalLink size={11} className="text-slate-600 group-hover:text-cyan-400 transition-colors shrink-0 mt-1" />
              </motion.a>
            ))}
          </AnimatePresence>
        )}
      </div>

      {/* Footer */}
      {lastFetch && !loading && (
        <div className="px-4 py-2 border-t border-slate-800/40 text-[10px] text-slate-600">
          Last updated {lastFetch.toLocaleTimeString()}
        </div>
      )}
    </div>
