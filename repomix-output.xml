                          <td className="p-4 text-center font-mono">{post.commentsCount}</td>
                          <td className="p-4 text-center font-mono">{post.bookmarksCount}</td>
                          <td className="p-4 text-center font-mono font-bold text-cyan-400">{post.score}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </motion.div>
          )}
        </AnimatePresence>
      </div>

      {/* Editor Modal Sheet */}
