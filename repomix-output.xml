import React, { useState, useEffect, useRef } from "react";
import { useNavigate } from "react-router-dom";
import { useApp } from "../context/AppContext";
import { useTheme } from "../context/ThemeContext";
import { motion, AnimatePresence } from "framer-motion";
import { Search, FileText, ArrowRight, Sun, Moon, Sparkles, Layout, User, BookOpen } from "lucide-react";

export default function CommandPalette({ isOpen, onClose }) {
  const { state, switchUser, showToast } = useApp();
  const { theme, toggleTheme } = useTheme();
  const [query, setQuery] = useState("");
  const navigate = useNavigate();
  const inputRef = useRef(null);

  // Focus input on open
  useEffect(() => {
    if (isOpen) {
      setTimeout(() => inputRef.current?.focus(), 100);
      setQuery("");
    }
  }, [isOpen]);

  // Handle global escape key
  useEffect(() => {
    const handleKeyDown = (e) => {
      if (e.key === "Escape") {
        onClose();
      }
    };
    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, [onClose]);

  if (!isOpen) return null;

  // Filter posts
  const filteredPosts = state.posts.filter(p =>
    p.title.toLowerCase().includes(query.toLowerCase()) ||
    p.excerpt.toLowerCase().includes(query.toLowerCase()) ||
    p.tag.toLowerCase().includes(query.toLowerCase())
  ).slice(0, 5);

  const navigations = [
    { name: "Go to Home", path: "/", icon: <Layout size={14} className="text-blue-400" /> },
    { name: "Go to Topics / Categories", path: "/categories", icon: <BookOpen size={14} className="text-purple-400" /> },
    { name: "Go to Dashboard", path: "/dashboard", icon: <Layout size={14} className="text-emerald-400" /> },
    { name: "Go to Reading List", path: "/reading-list", icon: <FileText size={14} className="text-amber-400" /> },
  ];

  const filteredNavs = navigations.filter(n =>
    n.name.toLowerCase().includes(query.toLowerCase())
  );

  const handleNav = (path) => {
    navigate(path);
    onClose();
  };

  const handleSwitchUser = (userId) => {
    switchUser(userId);
    onClose();
  };

  const handleToggleTheme = () => {
    if (toggleTheme) {
      toggleTheme();
      showToast(`Switched theme`, "info");
    }
    onClose();
  };

  return (
    <AnimatePresence>
      <div className="fixed inset-0 z-50 flex items-start justify-center pt-[12vh] px-4">
        {/* Backdrop */}
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          exit={{ opacity: 0 }}
          onClick={onClose}
          className="absolute inset-0 bg-slate-950/70 backdrop-blur-sm"
        />

        {/* Palette Container */}
        <motion.div
          initial={{ opacity: 0, scale: 0.97, y: -10 }}
          animate={{ opacity: 1, scale: 1, y: 0 }}
          exit={{ opacity: 0, scale: 0.97, y: -10 }}
          transition={{ duration: 0.15 }}
          className="relative bg-slate-900/95 border border-slate-800/80 w-full max-w-xl rounded-2xl overflow-hidden shadow-2xl z-10 flex flex-col max-h-[60vh] backdrop-blur-md"
        >
          {/* Search Input Bar */}
          <div className="flex items-center space-x-3 px-4 py-3.5 border-b border-slate-800/60 bg-slate-950/20">
            <Search className="text-slate-500 shrink-0" size={18} />
            <input
              ref={inputRef}
              type="text"
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              placeholder="Search posts, navigation links, theme toggle..."
              className="w-full bg-transparent border-none outline-none focus:ring-0 text-slate-200 placeholder-slate-500 text-sm"
            />
            <kbd className="hidden sm:inline-flex items-center px-1.5 py-0.5 border border-slate-800 rounded text-[9px] font-mono text-slate-500 bg-slate-950/60 select-none">
              ESC
            </kbd>
          </div>

          {/* Results Area */}
          <div className="overflow-y-auto p-2 divide-y divide-slate-800/40">
            {/* Navigations Section */}
            {filteredNavs.length > 0 && (
              <div className="py-2">
                <p className="px-3 py-1 text-[9px] font-bold text-slate-500 uppercase tracking-widest">Navigation</p>
                <div className="mt-1 space-y-0.5">
                  {filteredNavs.map((nav) => (
                    <button
                      key={nav.name}
                      onClick={() => handleNav(nav.path)}
                      className="w-full flex items-center justify-between px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-850 hover:text-cyan-400 text-xs text-left transition duration-150"
                    >
                      <div className="flex items-center space-x-2.5">
                        {nav.icon}
                        <span className="font-semibold">{nav.name}</span>
                      </div>
                      <ArrowRight size={11} className="text-slate-600" />
                    </button>
                  ))}
                </div>
              </div>
            )}

            {/* Articles Search Section */}
            {filteredPosts.length > 0 && (
              <div className="py-2">
                <p className="px-3 py-1 text-[9px] font-bold text-slate-500 uppercase tracking-widest">Articles</p>
                <div className="mt-1 space-y-0.5">
                  {filteredPosts.map((post) => (
                    <button
                      key={post.id}
                      onClick={() => handleNav(`/blog/${post.slug}`)}
                      className="w-full flex items-center justify-between px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-850 hover:text-cyan-400 text-xs text-left transition duration-150"
                    >
                      <div className="flex items-center space-x-2.5 min-w-0">
                        <FileText size={14} className="text-cyan-500 shrink-0" />
                        <span className="font-semibold truncate">{post.title}</span>
                      </div>
                      <span className="text-[10px] bg-slate-950/60 text-slate-500 px-2 py-0.5 rounded border border-slate-800 shrink-0 ml-2">
                        {post.tag}
                      </span>
                    </button>
                  ))}
                </div>
              </div>
            )}

            {/* Commands Actions Section */}
            <div className="py-2">
              <p className="px-3 py-1 text-[9px] font-bold text-slate-500 uppercase tracking-widest">Actions & Themes</p>
              <div className="mt-1 space-y-0.5 animate-none">
                {/* Theme Toggle */}
                {("toggle theme").includes(query.toLowerCase()) && (
                  <button
                    onClick={handleToggleTheme}
                    className="w-full flex items-center justify-between px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-850 hover:text-cyan-400 text-xs text-left transition duration-150"
                  >
                    <div className="flex items-center space-x-2.5">
                      <Sparkles size={14} className="text-amber-400" />
                      <span className="font-semibold">Toggle App Theme (Dark/Light/OLED)</span>
                    </div>
                    <span className="text-[10px] text-slate-500 font-mono capitalize">Current: {theme}</span>
                  </button>
                )}

                {/* Switch User Actions */}
                {Object.values({
                  alex: { id: "alex", name: "Switch to Alex Mercer" },
                  sarah: { id: "sarah", name: "Switch to Sarah Connor" },
                  john: { id: "john", name: "Switch to John Doe" }
                }).map(u => {
                  if (u.name.toLowerCase().includes(query.toLowerCase())) {
                    const isActive = state.currentUser.id === u.id;
                    return (
                      <button
                        key={u.id}
                        onClick={() => handleSwitchUser(u.id)}
                        className={`w-full flex items-center justify-between px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-850 hover:text-cyan-400 text-xs text-left transition duration-150 ${
                          isActive ? "text-cyan-400 font-bold" : ""
                        }`}
                      >
                        <div className="flex items-center space-x-2.5">
                          <User size={14} className="text-slate-500" />
                          <span>{u.name}</span>
                        </div>
                        {isActive && <span className="text-[9px] uppercase tracking-widest font-black text-cyan-400">active</span>}
                      </button>
                    );
                  }
                  return null;
                })}
              </div>
            </div>

            {/* No matches */}
            {filteredNavs.length === 0 && filteredPosts.length === 0 && (
              <div className="py-6 text-center text-slate-500 text-xs font-semibold">
                No commands or articles matching your search query.
              </div>
            )}
          </div>
        </motion.div>
      </div>
    </AnimatePresence>
  );
}
</file>

<file path="src/components/CommentSection.jsx">
import React, { useState } from "react";
import { useApp } from "../context/AppContext";
import { Trash2, Reply, MessageSquare } from "lucide-react";
import { motion, AnimatePresence } from "framer-motion";

export default function CommentSection({ postSlug }) {
  const { state, dispatch, showToast } = useApp();
  const comments = state.comments[postSlug] || [];
  const [commentText, setCommentText] = useState("");
  const [replyToId, setReplyToId] = useState(null);
  const [replyText, setReplyText] = useState("");

  const handleAddComment = (e) => {
    e.preventDefault();
    if (!commentText.trim()) return;

    const newComment = {
      id: "comment-" + Date.now(),
      content: commentText.trim(),
      date: new Date().toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric"
      }),
      author: {
        name: state.currentUser.name,
        avatar: state.currentUser.avatar
      },
      replies: []
    };

    dispatch({
      type: "ADD_COMMENT",
      payload: { postSlug, comment: newComment }
    });
    setCommentText("");
    showToast("Comment posted!");
  };

  const handleAddReply = (e, commentId) => {
    e.preventDefault();
    if (!replyText.trim()) return;

    const newReply = {
      id: "reply-" + Date.now(),
      content: replyText.trim(),
      date: new Date().toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric"
      }),
      author: {
        name: state.currentUser.name,
        avatar: state.currentUser.avatar
      }
    };

    dispatch({
      type: "ADD_REPLY",
      payload: { postSlug, commentId, reply: newReply }
    });
    setReplyText("");
    setReplyToId(null);
    showToast("Reply posted!");
  };

  const handleDeleteComment = (commentId) => {
    if (confirm("Are you sure you want to delete this comment?")) {
      dispatch({
        type: "DELETE_COMMENT",
        payload: { postSlug, commentId }
      });
      showToast("Comment deleted", "info");
    }
  };

  const handleDeleteReply = (commentId, replyId) => {
    if (confirm("Are you sure you want to delete this reply?")) {
      dispatch({
        type: "DELETE_REPLY",
        payload: { postSlug, commentId, replyId }
      });
      showToast("Reply deleted", "info");
    }
  };

  const totalCommentsCount = comments.reduce(
    (acc, curr) => acc + 1 + (curr.replies ? curr.replies.length : 0),
    0
  );

  return (
    <div className="mt-12 pt-10 border-t border-slate-800/80">
      <div className="flex items-center space-x-3 mb-8">
        <MessageSquare className="text-cyan-400" size={24} />
        <h3 className="text-2xl font-bold text-slate-100">
          Comments ({totalCommentsCount})
        </h3>
      </div>

      {/* Main Comment Input */}
      <form onSubmit={handleAddComment} className="flex space-x-4 mb-10">
        <img
          src={state.currentUser.avatar}
          alt={state.currentUser.name}
          className="w-10 h-10 rounded-full bg-slate-800 shrink-0"
        />
        <div className="flex-grow space-y-3">
          <textarea
            value={commentText}
            onChange={(e) => setCommentText(e.target.value)}
            placeholder="Share your thoughts or ask a question..."
            rows="3"
            className="w-full px-4 py-3 bg-slate-950/50 border border-slate-800 rounded-xl focus:ring-2 focus:ring-cyan-500 focus:border-transparent outline-none transition-all duration-300 text-slate-200 placeholder-slate-500 resize-none text-sm leading-relaxed"
          />
          <div className="flex justify-end">
            <button
              type="submit"
              disabled={!commentText.trim()}
              className="px-5 py-2.5 bg-gradient-to-r from-cyan-500 to-blue-500 text-white font-semibold rounded-lg text-sm transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/20 hover:opacity-95 disabled:opacity-50 disabled:pointer-events-none"
            >
              Post Comment
            </button>
          </div>
        </div>
      </form>

      {/* Comments List */}
      <div className="space-y-6">
        <AnimatePresence>
          {comments.map((comment) => (
            <motion.div
              key={comment.id}
              initial={{ opacity: 0, y: 10 }}
              animate={{ opacity: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.95 }}
              className="bg-slate-900/20 border border-slate-800 p-6 rounded-2xl relative"
            >
              {/* Header */}
              <div className="flex items-center justify-between mb-3">
                <div className="flex items-center space-x-3">
                  <img
                    src={comment.author.avatar}
                    alt={comment.author.name}
                    className="w-9 h-9 rounded-full bg-slate-900"
                  />
                  <div>
                    <h4 className="text-sm font-bold text-slate-200">
                      {comment.author.name}
                    </h4>
                    <span className="text-xs text-slate-500">{comment.date}</span>
                  </div>
                </div>

                {comment.author.name === state.currentUser.name && (
                  <button
                    onClick={() => handleDeleteComment(comment.id)}
                    className="text-slate-500 hover:text-rose-400 transition-colors p-1"
                    aria-label="Delete comment"
                  >
                    <Trash2 size={16} />
                  </button>
                )}
              </div>

              {/* Content */}
              <p className="text-sm text-slate-300 leading-relaxed pl-12">
                {comment.content}
              </p>

              {/* Actions */}
              <div className="mt-4 pl-12 flex space-x-4">
                <button
                  onClick={() => {
                    setReplyToId(replyToId === comment.id ? null : comment.id);
                    setReplyText("");
                  }}
                  className="flex items-center text-xs text-slate-500 hover:text-cyan-400 font-semibold transition-colors"
                >
                  <Reply size={14} className="mr-1.5" />
                  Reply
                </button>
              </div>

              {/* Reply Form */}
              {replyToId === comment.id && (
                <form
                  onSubmit={(e) => handleAddReply(e, comment.id)}
                  className="mt-4 pl-12 flex space-x-3"
                >
                  <img
                    src={state.currentUser.avatar}
                    alt={state.currentUser.name}
                    className="w-8 h-8 rounded-full bg-slate-800 shrink-0"
                  />
                  <div className="flex-grow space-y-2">
                    <input
                      type="text"
                      value={replyText}
                      onChange={(e) => setReplyText(e.target.value)}
                      placeholder="Write a reply..."
                      className="w-full px-3 py-2 bg-slate-950/70 border border-slate-800 rounded-lg focus:ring-1 focus:ring-cyan-500 focus:border-transparent outline-none transition-all text-xs text-slate-200 placeholder-slate-500"
                    />
                    <div className="flex justify-end space-x-2">
                      <button
                        type="button"
                        onClick={() => setReplyToId(null)}
                        className="px-3 py-1.5 border border-slate-800 text-slate-400 rounded-md text-xs hover:bg-slate-800/50 hover:text-slate-200 transition-colors"
                      >
                        Cancel
                      </button>
                      <button
                        type="submit"
                        disabled={!replyText.trim()}
                        className="px-3 py-1.5 bg-cyan-600 hover:bg-cyan-500 text-white rounded-md text-xs font-semibold transition-all disabled:opacity-55"
                      >
                        Reply
                      </button>
                    </div>
                  </div>
                </form>
              )}

              {/* Nested Replies */}
              {comment.replies && comment.replies.length > 0 && (
                <div className="mt-4 pl-12 space-y-4 border-l border-slate-800/80">
                  {comment.replies.map((reply) => (
                    <div key={reply.id} className="relative pt-2">
                      <div className="flex items-center justify-between mb-2">
                        <div className="flex items-center space-x-2">
                          <img
                            src={reply.author.avatar}
                            alt={reply.author.name}
                            className="w-7 h-7 rounded-full bg-slate-900"
                          />
                          <div>
                            <h5 className="text-xs font-bold text-slate-300">
                              {reply.author.name}
                            </h5>
                            <span className="text-[10px] text-slate-500">
                              {reply.date}
                            </span>
                          </div>
                        </div>

                        {reply.author.name === state.currentUser.name && (
                          <button
                            onClick={() => handleDeleteReply(comment.id, reply.id)}
                            className="text-slate-500 hover:text-rose-400 transition-colors p-1"
                            aria-label="Delete reply"
                          >
                            <Trash2 size={13} />
                          </button>
                        )}
                      </div>
                      <p className="text-xs text-slate-400 leading-relaxed pl-9">
                        {reply.content}
                      </p>
                    </div>
                  ))}
                </div>
              )}
            </motion.div>
          ))}
        </AnimatePresence>
      </div>
    </div>
  );
}
</file>

